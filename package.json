# İş akışının adı
name: Lint, Security and Deploy

# Tetikleyiciler
on:
  push:
    branches:
      - main
  pull_request:
    branches:
      - main

# İşler
jobs:
  # --- İŞ 1: Kod Kalitesini ve Güvenliği Kontrol Et ---
  lint-and-security:
    name: Code Quality and Security Checks
    runs-on: ubuntu-latest
    
    steps:
      # Kodu çek
      - name: Checkout code
        uses: actions/checkout@v4
      
      # Node.js kur (cache'i şimdilik devre dışı bırakıyoruz)
      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'
      
      # package.json yoksa oluştur ve gerekli paketleri yükle
      - name: Initialize npm and install linting tools
        run: |
          # package.json yoksa oluştur
          if [ ! -f package.json ]; then
            echo "📦 Creating package.json..."
            cat > package.json << 'EOF'
          {
            "name": "fokus-web-app",
            "version": "1.0.0",
            "description": "Fokus Web Application",
            "main": "index.js",
            "scripts": {
              "lint": "npm run lint:js && npm run lint:css",
              "lint:js": "eslint . --ext .js,.html --ignore-path .gitignore",
              "lint:css": "stylelint '**/*.css' --ignore-path .gitignore",
              "lint:fix": "eslint . --ext .js,.html --fix && stylelint '**/*.css' --fix"
            },
            "keywords": ["fokus", "web", "app"],
            "author": "Ibrahim Gokdemir",
            "license": "MIT",
            "devDependencies": {}
          }
          EOF
          fi
          
          # Development dependencies olarak linting araçlarını yükle
          echo "📥 Installing linting tools..."
          npm install --save-dev \
            eslint@^8.57.0 \
            stylelint@^16.3.1 \
            stylelint-config-standard@^36.0.0 \
            eslint-plugin-html@^8.1.1
          
          echo "✅ Dependencies installed successfully"
          
          # .gitignore'a node_modules ekle (eğer yoksa)
          if [ ! -f .gitignore ]; then
            echo "node_modules/" > .gitignore
            echo "package-lock.json" >> .gitignore
          elif ! grep -q "node_modules" .gitignore; then
            echo "node_modules/" >> .gitignore
          fi
          
          if ! grep -q "package-lock.json" .gitignore; then
            echo "package-lock.json" >> .gitignore
          fi
      
      # ESLint yapılandırmasını kontrol et ve gerekirse güncelle
      - name: Setup ESLint configuration
        run: |
          echo "🔧 Setting up ESLint configuration..."
          cat > .eslintrc.json << 'EOF'
          {
            "env": {
              "browser": true,
              "es2021": true
            },
            "extends": "eslint:recommended",
            "parserOptions": {
              "ecmaVersion": "latest",
              "sourceType": "module"
            },
            "plugins": ["html"],
            "rules": {
              "indent": ["warn", 2],
              "linebreak-style": ["warn", "unix"],
              "quotes": ["warn", "single"],
              "semi": ["warn", "always"],
              "no-unused-vars": "warn",
              "no-console": "warn"
            },
            "ignorePatterns": ["node_modules/", "*.min.js", "dist/"]
          }
          EOF
          echo "✅ ESLint configured"
      
      # Stylelint yapılandırmasını kontrol et ve gerekirse güncelle
      - name: Setup Stylelint configuration
        run: |
          echo "🎨 Setting up Stylelint configuration..."
          cat > .stylelintrc.json << 'EOF'
          {
            "extends": "stylelint-config-standard",
            "rules": {
              "indentation": 2,
              "string-quotes": "single",
              "color-hex-case": "lower",
              "color-hex-length": "short",
              "selector-class-pattern": null
            },
            "ignoreFiles": ["node_modules/**", "**/*.min.css", "dist/**"]
          }
          EOF
          echo "✅ Stylelint configured"
      
      # Proje dosyalarını listele (debug için)
      - name: List project files
        run: |
          echo "📂 Project structure:"
          ls -la
          echo ""
          echo "📄 Looking for JS files:"
          find . -type f -name "*.js" ! -path "./node_modules/*" 2>/dev/null | head -10 || echo "No JS files found"
          echo ""
          echo "🎨 Looking for CSS files:"
          find . -type f -name "*.css" ! -path "./node_modules/*" 2>/dev/null | head -10 || echo "No CSS files found"
          echo ""
          echo "📄 Looking for HTML files:"
          find . -type f -name "*.html" ! -path "./node_modules/*" 2>/dev/null | head -10 || echo "No HTML files found"
      
      # JavaScript dosyalarını kontrol et
      - name: Run ESLint
        run: |
          echo "🔍 Running ESLint..."
          # site klasöründe JS dosyaları var mı kontrol et
          if [ -d "site" ]; then
            if find site -name "*.js" -o -name "*.html" 2>/dev/null | grep -q .; then
              echo "Found files in site directory"
              npx eslint site --ext .js,.html --ignore-path .gitignore --no-error-on-unmatched-pattern || true
            fi
          fi
          
          # Root dizinde JS dosyaları var mı kontrol et
          if find . -maxdepth 1 -name "*.js" -o -name "*.html" 2>/dev/null | grep -q .; then
            echo "Found files in root directory"
            npx eslint . --ext .js,.html --ignore-path .gitignore --no-error-on-unmatched-pattern || true
          else
            echo "ℹ️ No JavaScript or HTML files found to lint"
          fi
        continue-on-error: true
      
      # CSS dosyalarını kontrol et
      - name: Run Stylelint
        run: |
          echo "🎨 Running Stylelint..."
          # CSS dosyası var mı kontrol et
          if find . -name "*.css" ! -path "./node_modules/*" 2>/dev/null | grep -q .; then
            npx stylelint "**/*.css" --ignore-path .gitignore --allow-empty-input || true
          else
            echo "ℹ️ No CSS files found to lint"
          fi
        continue-on-error: true
      
      # CodeQL güvenlik analizi başlat
      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: javascript
          queries: security-and-quality
        continue-on-error: true
      
      # Autobuild (CodeQL için)
      - name: Autobuild
        uses: github/codeql-action/autobuild@v3
        continue-on-error: true
      
      # CodeQL analizini gerçekleştir
      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
        with:
          category: "/language:javascript"
        continue-on-error: true
      
      # Oluşturulan dosyaları commit et (sadece main branch'te ve push event'inde)
      - name: Commit generated files if needed
        if: github.event_name == 'push' && github.ref == 'refs/heads/main' && success()
        run: |
          git config --local user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git config --local user.name "github-actions[bot]"
          
          # package.json ve config dosyalarını ekle (package-lock.json hariç)
          git add -f package.json .eslintrc.json .stylelintrc.json .gitignore 2>/dev/null || true
          
          # Değişiklik var mı kontrol et
          if ! git diff --staged --quiet; then
            echo "📝 Committing configuration files..."
            git commit -m "🔧 Auto-generate npm and linting configuration files [skip ci]"
            git push origin main || echo "⚠️ Push failed or no changes to push"
          else
            echo "ℹ️ No changes to commit"
          fi
        continue-on-error: true

  # --- İŞ 2: Sunucuya Dağıt ---
  deploy:
    name: Deploy to Production VPS
    # Bu iş, sadece 'lint-and-security' işi tamamlandığında çalışır
    needs: lint-and-security
    # Her zaman çalışır (lint başarısız olsa bile)
    if: |
      always() && 
      github.event_name == 'push' && 
      github.ref == 'refs/heads/main' &&
      !cancelled()
    runs-on: self-hosted
    
    steps:
      # En son kodu çek
      - name: Pull latest source code
        run: |
          echo "📥 Pulling latest code..."
          cd /home/ibra/projects/fokus-web-app
          git pull origin main
      
      # Docker container'ları yeniden başlat
      - name: Rebuild and Deploy Docker Container
        run: |
          echo "🐳 Restarting Docker containers..."
          cd /home/ibra/projects/fokus-web-app
          docker compose down
          docker compose up -d --build
      
      # Deployment durumunu kontrol et
      - name: Verify deployment
        run: |
          cd /home/ibra/projects/fokus-web-app
          echo "✅ Checking container status..."
          docker compose ps
          echo "🎉 Deployment completed successfully!"